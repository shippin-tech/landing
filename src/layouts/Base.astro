---
import brand from '../brand.generated.json';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const c = brand.colors;
const ld = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: brand.name,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Linux, Docker',
	description,
	url: `https://${brand.domain}/`,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', description: 'Free tier for small organisations' }
};
---
<!doctype html>
<html lang="en" style={`--ink:${c.ink};--sky:${c.sky};--tan:${c.tan};--gold:${c.gold};--cyan:${c.accent};`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content={c.ink} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={brand.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/favicon.svg', Astro.site).toString()} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" set:html={JSON.stringify(ld)} />
		<script is:inline>
			try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: var(--ink); --fg: #eef2ff; --muted: #9aa6c4; --card: #131a30; --line: #25304f;
		color-scheme: dark;
	}
	:root[data-theme='light'] {
		--bg: #f6f8ff; --fg: #0b1020; --muted: #4b5675; --card: #ffffff; --line: #d3daf0;
		color-scheme: light;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
	body { margin: 0; background: var(--bg); color: var(--fg); font: 1.0625rem/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif; }
	a { color: var(--cyan); }
	h1, h2, h3 { line-height: 1.1; margin: 0 0 0.6em; }
	h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); letter-spacing: -0.02em; }
	h2 { font-size: clamp(1.8rem, 4vw, 3rem); }
	.mono { font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace; }
	#field { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0.55; }
	header.top, main, footer { position: relative; z-index: 1; }
	header.top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem clamp(1rem, 4vw, 3rem); }
	header.top nav { display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; }
	header.top nav a { color: var(--fg); text-decoration: none; }
	header.top nav a:hover { color: var(--cyan); }
	.logo { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 700; color: var(--fg); text-decoration: none; }
	.logo svg { width: 2rem; height: 2rem; }
	.logo b { color: var(--cyan); }
	.step { min-height: 90vh; display: grid; align-content: center; padding: 4rem clamp(1rem, 6vw, 6rem); max-width: 72rem; }
	.step p { max-width: 40rem; color: var(--muted); font-size: 1.15rem; }
	.eyebrow { color: var(--gold); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.75rem; }
	.cta { display: inline-block; background: var(--cyan); color: #04202a; padding: 0.8rem 1.4rem; border-radius: 0.6rem; font-weight: 700; text-decoration: none; border: 0; cursor: pointer; font-size: 1rem; }
	.cta.ghost { background: transparent; color: var(--fg); border: 1px solid var(--line); }
	.row { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.4rem; }
	.card { background: color-mix(in srgb, var(--card) 88%, transparent); border: 1px solid var(--line); border-radius: 1rem; padding: 1.25rem 1.5rem; max-width: 34rem; backdrop-filter: blur(6px); }
	.checks { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.5rem; }
	.checks label { display: flex; gap: 0.7rem; align-items: center; color: var(--fg); }
	.checks small { color: var(--muted); }
	input[type='checkbox'] { inline-size: 1.15rem; block-size: 1.15rem; accent-color: var(--cyan); }
	form.signup { display: grid; gap: 0.7rem; max-width: 30rem; }
	form.signup input[type='email'], form.signup input[type='text'], form.signup select { padding: 0.8rem 1rem; border-radius: 0.6rem; border: 1px solid var(--line); background: var(--card); color: var(--fg); font: inherit; }
	.hp { position: absolute; left: -9999px; }
	.tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin: 1.5rem 0; }
	.tiers .card b { color: var(--gold); }
	footer { padding: 3rem clamp(1rem, 6vw, 6rem); color: var(--muted); border-top: 1px solid var(--line); background: var(--bg); }
	.skip { position: absolute; left: -9999px; }
	.skip:focus { left: 1rem; top: 1rem; background: var(--cyan); color: #000; padding: 0.5rem 1rem; z-index: 9; }
	:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
</style>
